# Configuracion local de ObraViva. levantar.ps1 copia este archivo a .env si no existe.
# Sin claves funciona todo con los simuladores: .\levantar.ps1 -Simulado

# Carga los dos barrios de demostracion y sus cuentas de prueba.
OBRAVIVA_DEMO_SEED=true

# --- Opcional: servicios reales (ver el README) ---

# Interpretacion de audios con Gemini: .\levantar.ps1, sin -Simulado.
# GEMINI_API_KEY=

# Transcripcion local: ruta al modelo ggml-small.bin de whisper.cpp.
# OBRAVIVA_WHISPER_MODEL=C:\modelos\ggml-small.bin

# Reconstruccion 3D con KIRI Engine. Cada video que se sube consume un credito.
# OBRAVIVA_RECONSTRUCTION_PROVIDER=kiri
# KIRI_API_KEY=

# Simulador de reconstruccion: PLY que devuelve en lugar de un modelo real.
# OBRAVIVA_SAMPLE_PLY=C:\modelos\muestra.ply

# Otra captura .spz para los recorridos de la demostracion, en vez de la incluida.
# OBRAVIVA_DEMO_SPLAT=C:\modelos\muestra.spz
